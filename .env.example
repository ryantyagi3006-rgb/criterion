# Copy to .env and fill in. Never commit the real .env, it is gitignored.

# Postgres. Vercel gives you two strings when you create a database:
# a pooled one and an unpooled ("direct") one. Both are needed.
# Queries use the pooled string:
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"
# Migrations use the direct string, because they fail through a pooler:
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Signs the session cookies. Use a long random value in production:
#   openssl rand -base64 32
AUTH_SECRET="change-me"

# Free key from https://aistudio.google.com/apikey
# Without it the app still runs, but uploads produce a demo task instead of
# parsing the real document, and marking falls back to manual scoring.
GEMINI_API_KEY=""
